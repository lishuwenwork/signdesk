# Bind mount path for the SQLite data directory.
# Compose reads this only when the file is named .env and sits next to the compose file
# (or when passing --env-file). A missing directory is a startup error by design.
#
# The container always reads and writes SQLite at /app/data, which is set by
# SIGNDESK_DATA_DIR in the image; only the host side changes here.
SIGNDESK_HOST_DATA=/root/signdesk/data

# Host port. Host and container port must stay identical (same-port mapping), because
# RequestBoundary compares the browser Origin port with the port Tomcat received.
SIGNDESK_PORT=10500

# Optional: explicit private-host allowlist for the outbound HTTP requests (not for
# who may open the management page).
SIGNDESK_ALLOWED_HOSTS=
