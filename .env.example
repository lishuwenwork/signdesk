# Shared by Jib tar deployment and Dockerfile source builds; copy to .env to use.
SIGNDESK_IMAGE=signdesk:0.1.0
# Host directory must already exist and be writable by container UID/GID 10001:10001.
SIGNDESK_HOST_DATA=/root/signdesk/data
# Use 127.0.0.1 for a local reverse proxy or SSH tunnel instead of public access.
SIGNDESK_PUBLISH_ADDRESS=0.0.0.0
# Host and container ports stay identical for browser Origin validation.
SIGNDESK_PORT=10500
SIGNDESK_AUTH_USERNAME=admin
# Required: choose a strong, unique password before starting Docker Compose.
SIGNDESK_AUTH_PASSWORD=
# Enable only when the browser accesses the service over HTTPS.
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
# Explicit private-host allowlist for outbound requests, not management access.
SIGNDESK_ALLOWED_HOSTS=
